				    #"Replaced Value" = Table.ReplaceValue(#"Expanded gold dim_line_of_business",null,"Others",Replacer.ReplaceValue,{"gold dim coverage c.coverage__c"}),
				    #"Replaced Value2" = Table.ReplaceValue(#"Replaced Value","General Package Policy","Others",Replacer.ReplaceText,{"gold dim coverage c.coverage__c"}),
				    #"Replaced Value3" = Table.ReplaceValue(#"Replaced Value2","Cyber","Others",Replacer.ReplaceValue,{"gold dim coverage c.coverage__c"}),
				    #"Replaced Value4" = Table.ReplaceValue(#"Replaced Value3","Specialty Cyber","Others",Replacer.ReplaceText,{"gold dim coverage c.coverage__c"}),
				    #"Replaced Value5" = Table.ReplaceValue(#"Replaced Value4","Specialty Errors & Omissions","Others",Replacer.ReplaceText,{"gold dim coverage c.coverage__c"}),
				    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value5",null,"Others",Replacer.ReplaceValue,{"gold dim_line_of_business.LoB"}),
				    #"Added Custom" = Table.AddColumn(#"Replaced Value1", "Record Buckets", each if [Entry Type] = "Endorsement Entry" then "Endorsements" else if [Entry Type] = "Cancellation Entry" then "Cancellations" else if [Record Types] = "New " then "New" else if [Record Types] = "Renewal" then "Renewal" else "Others"),
				    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Waterfall Buckets", each if Date.Year([Inception Date]) = Date.Year(DateTime.LocalNow()) - 1 then Number.ToText(Date.Year(DateTime.LocalNow()) - 1) else if Date.Year([Inception Date]) = Date.Year(DateTime.LocalNow()) and Date.QuarterOfYear([Inception Date]) = Date.QuarterOfYear(DateTime.LocalNow()) and [Record Buckets] = "New" then Number.ToText(Date.Year(DateTime.LocalNow())) & " Q1 N" else "null")
				in
				    #"Added Custom1"

