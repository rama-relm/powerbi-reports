	partition 'gold premiums_coverage' = m
		mode: import
		source =
				let
				    Source = Table.Combine({#"gold coverage_view", #"gold endorsements_cancellations"}),
				    #"Merged Queries" = Table.NestedJoin(Source, {"Coverage"}, #"gold dim coverage c", {"coverage__c"}, "gold dim coverage c", JoinKind.LeftOuter),
				    #"Expanded gold dim coverage c" = Table.ExpandTableColumn(#"Merged Queries", "gold dim coverage c", {"coverage__c"}, {"gold dim coverage c.coverage__c"}),
