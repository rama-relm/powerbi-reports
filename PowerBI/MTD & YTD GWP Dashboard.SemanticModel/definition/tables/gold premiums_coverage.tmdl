	measure '2025 YTD' = ```
			
			 VAR CurrentDate =
			    CALCULATE ( MAX ( 'Date Table'[Date] ), 'Date Table'[Year] = 2025 )
			RETURN
			CALCULATE (
			    [Premiums],
			    FILTER (
			        ALL ( 'Date Table' ),
