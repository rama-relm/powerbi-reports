table 'gold premiums_coverage'
	lineageTag: f375c64f-3f6d-4caf-b9b3-9bdc3d333561

	measure '2026 MTD' =
			VAR CurrentDate =
			    CALCULATE ( MAX ( 'Date Table'[Date] ), 'Date Table'[Year] = 2026 )
			RETURN
			CALCULATE (
			    [Premiums],
			    FILTER (
			        ALL ( 'Date Table' ),
			        'Date Table'[Year] = 2026
			            && 'Date Table'[Date] <= CurrentDate
			            && 'Date Table'[MonthNum] = MONTH ( CurrentDate )
			    )
			)
		lineageTag: 4a115ea2-314f-49ee-88ea-3f2422b9afe0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '2025 MTD' = ```
			
			VAR CurrentDate =
			    CALCULATE ( MAX ( 'Date Table'[Date] ), 'Date Table'[Year] = 2025 )
			RETURN
			CALCULATE (
			    [Premiums],
			    FILTER (
			        ALL ( 'Date Table' ),
			        'Date Table'[Year] = 2025
			            && 'Date Table'[Date] <= CurrentDate
			            && 'Date Table'[MonthNum] = MONTH ( CurrentDate )
			    )
			)
			
			```
		lineageTag: a8e14ff1-d74d-4a25-82e1-bba8d6f65556

		annotation PBI_FormatHint = {"isGeneralNumber":true}

