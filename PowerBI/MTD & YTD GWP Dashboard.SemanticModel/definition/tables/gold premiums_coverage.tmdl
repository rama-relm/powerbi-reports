			```
		lineageTag: 0c7110eb-58eb-4bc0-9185-8661f44819e3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Width = REPT("0", 15)
		lineageTag: de15caf7-d70e-4e99-81ef-1622451c1152

	measure Premiums = ```
			
			CALCULATE(
			    SUM(bi_coverage_level_view[relm_coverage_premium_converted]),
			    USERELATIONSHIP(
			        'Date Table'[Date],
			        bi_coverage_level_view[inception_date]
			    )
			    --,bi_coverage_level_view[entry_type] = "Policy Entry"
			)
			
			```
		lineageTag: 1f485af6-215f-41a0-b2af-6b7f3acd5383

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Inception Year Check' = ```
			
			CONCATENATEX(
			    VALUES(bi_coverage_level_view[inception_year]),
			    bi_coverage_level_view[inception_year],
			    ", "
			)
			
			
			```
		lineageTag: 9459d65e-40f2-4ebd-8e59-038dbda92281

	measure '2025 Premium Test' = ```
			
			CALCULATE(
			    SUM(bi_coverage_level_view[relm_coverage_premium_converted]),
			    bi_coverage_level_view[inception_year] = "2025"
			)
			
			```
		lineageTag: 9ee964b6-990b-4faf-83cb-922f2d59ec4b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '2025 MTD Test' = ```
			CALCULATE( 
			                        SUM(bi_coverage_level_view[relm_coverage_premium_converted]), 
			                        bi_coverage_level_view[entry_type] = "Policy Entry", bi_coverage_level_view[inception_year] = "2025", 
			                        FILTER(
			                             ALL(
			                                'Date Table'
			                                ), 
			                                'Date Table'[Year] = 2025 ) )
			```
		lineageTag: 49876f40-c861-4173-a18f-3348e34f79b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Premium Per Million' = DIVIDE([Premiums],1000000,0)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 1d38d978-6e88-49a6-a7aa-1817b5be2413

	measure Test1 =
			
			CALCULATE(
			    SUM(bi_coverage_level_view[relm_coverage_premium_converted]),
			    bi_coverage_level_view[entry_type] = "Policy Entry",
			    bi_coverage_level_view[inception_year] = "2025")
		lineageTag: db7e834d-16ee-4cc2-be9d-569c0b595859

		annotation PBI_FormatHint = {"isGeneralNumber":true}

