	partition 'Date Table' = calculated
		mode: import
		source = ```
				
				
				VAR StartDate = DATE(2020, 1, 1)
				
				VAR EndDate   = DATE(YEAR(TODAY())+5, 12, 31)
				
				RETURN
				
				ADDCOLUMNS (
				
				    CALENDAR ( StartDate, EndDate ),
				
				    "Year", YEAR ( [Date] ),
				
				    "Month", FORMAT ( [Date], "mmmm" ),
				
				    "MonthNum", MONTH ( [Date] ),
				
				    "Quarter", Quarter ( [Date] ),
				
				    "YearMonth", FORMAT ( [Date], "mmm-yy" ),
				
				    "YearMonthSort", FORMAT ( [Date], "YYYYMM")
				
				)
				
				 
				```

	annotation PBI_Id = 8d2e8e0884ea403cbfe0f03217c7e5da

