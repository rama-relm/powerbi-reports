	measure Remarks = ```
			
			VAR CoverageList =
			    DISTINCT('gold coverage_view'[coverage_code__c])
			
			VAR CoverageCount =
			    COUNTROWS(CoverageList)
			
			VAR HasIMI =
			    CALCULATE(
			        COUNTROWS('gold coverage_view'),
			        CONTAINSSTRING('gold coverage_view'[package_name], "IMI")
			    ) > 0
			
			VAR HasPackage =
			    CALCULATE(
			        COUNTROWS('gold coverage_view'),
			        CONTAINSSTRING('gold coverage_view'[package_name], "Package")
			    ) > 0
			
			VAR ConcatList =
			    CONCATENATEX(
			        CoverageList,
			        'gold coverage_view'[coverage_code__c],
			        ", "
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    CoverageCount > 1 && HasIMI,
			        "IMI (" & ConcatList & ")",
			
			    CoverageCount > 1 && HasPackage,
			        "Package (" & ConcatList & ")",
			
			    ConcatList
			)
			
			```
		lineageTag: 8eb3c003-e599-4158-87f4-cc9c90841583

