	column 'Opportunity Category' = ```
			
			SWITCH(
			    TRUE(),
			
			    // Renewal
			    'gold coverage_view'[record_type_name] = "Renewal" &&
			    'gold coverage_view'[created_by_name] IN {
			        "Jenny Anden", "Clarisse De La Cruz", "Miguel Estoesta"
			    },
			        "Renewal",
			
			    // MENA
			    'gold coverage_view'[record_type_name] = "New" &&
			    'gold coverage_view'[relm_entity] = "Relm Insurance MENA Ltd." &&
			    'gold coverage_view'[client_billing_country] IN {"United Arab Emirates","Bahrain","Turkey","Saudi Arabia","Armenia","Uzbekistan"},
			        "MENA",
			    'gold coverage_view'[record_type_name] = "New" &&
			    'gold coverage_view'[broker_region] = "United States" 
			       , "US MGA",
			    // UK
			    'gold coverage_view'[record_type_name] = "New" &&
			            'gold coverage_view'[broker_region] = "United Kingdom" ,
			        "UK",
			
			    // BDA
			    'gold coverage_view'[record_type_name] = "New" &&
			    (
			        'gold coverage_view'[broker_region] = "Bermuda" ||
			        NOT(
			            'gold coverage_view'[broker_region]
			                IN {"United States", "United Kingdom", "United Arab Emirates", "Canada"}
			        )
			    ),
			        "BDA",
			
			    // CANADA
			    'gold coverage_view'[record_type_name] = "New" &&
			    (
			        'gold coverage_view'[broker_region] = "Canada" ||
			        NOT(
			            'gold coverage_view'[broker_region]
			                IN {"United States", "United Kingdom", "United Arab Emirates", "Bermuda"}
			        )
			    ),
			        "Canada",
			
			    // Default
			    "Other"
			)
			```
		lineageTag: facf077c-f673-4909-9376-fa4b04edd22a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

