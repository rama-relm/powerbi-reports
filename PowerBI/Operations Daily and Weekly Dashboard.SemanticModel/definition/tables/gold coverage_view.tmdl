table 'gold coverage_view'
	lineageTag: 1821f90e-4f7a-43e2-89bc-f21b00547492

	measure 'BDA Total Opportunities Submitted' = ```
			FORMAT( COALESCE(
			
			CALCULATE(
			    COUNT('gold coverage_view'[opportunity_id]),'gold coverage_view'[record_type_name]="New",
			    'gold coverage_view'[relm_entity] = "Relm Insurance Ltd." && 
			        ('gold coverage_view'[broker_mailing_country] = "Bermuda" || 
			          NOT('gold coverage_view'[broker_mailing_country] IN {"United States", "United Kingdom", "United Arab Emirates"}))
			
			), 0),  "#,#0")
			```
		displayFolder: Old Measures
		lineageTag: b821347d-11c8-4cfb-a26f-af8203b4c978

	measure 'UK Total Opportunities Submitted' = ```
			FORMAT(COALESCE(
			
			CALCULATE(
			    COUNT([opportunity_id]),'gold coverage_view'[record_type_name]="New",
			    ('gold coverage_view'[relm_entity] = "Relm Insurance Ltd." 
			        && 'gold coverage_view'[broker_mailing_country] = "United Kingdom" 
			        && 'gold coverage_view'[client_billing_country] <> "United Kingdom") 
			        
			        || 
			    
			    ('gold coverage_view'[relm_entity] = "Relm Ins UK Ltd" 
			        && 'gold coverage_view'[broker_mailing_country] = "United Kingdom" 
			        && 'gold coverage_view'[client_billing_country] = "United Kingdom")
			
			),0), "#,#0")
			```
		displayFolder: Old Measures
		lineageTag: e2cd3cca-c7b9-4282-adde-70049c4cc22e

	measure 'US MGA RIAI' = ```
			
			
