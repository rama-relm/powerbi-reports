	column structure_bonus_points
		dataType: int64
		formatString: 0
		lineageTag: d5be3eaf-9ce0-46dd-bd89-0b8a5eb2d703
		summarizeBy: sum
		sourceColumn: structure_bonus_points

		annotation SummarizationSetBy = Automatic

	column 'BDA Filter' = ```
			
			
			    IF(
			    'gold coverage_view'[relm_entity] = "Relm Insurance Ltd." && 
			        ('gold coverage_view'[broker_mailing_country] = "Bermuda" || 
			          NOT('gold coverage_view'[broker_mailing_country] IN {"United States", "United Kingdom", "United Arab Emirates"})), 1, 0
			    )
			```
		formatString: 0
		displayFolder: Old Measures
		lineageTag: 7d1c04a8-8b49-4703-8b17-16858338e669
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'MENA Filter' = ```
			
			
			IF(
			    ('gold coverage_view'[relm_entity] = "Relm Insurance MENA Ltd." 
			        && 'gold coverage_view'[client_billing_country] = "United Arab Emirates"),
			
			        1,0
			
			)
			```
		formatString: 0
		displayFolder: Old Measures
		lineageTag: 0c9ed3ae-954f-4498-8ba0-4cd5f1f26a88
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'UK Filter' = ```
			
			
			IF(
			    ('gold coverage_view'[relm_entity] = "Relm Insurance Ltd." 
			        && 'gold coverage_view'[broker_mailing_country] = "United Kingdom" 
			        && 'gold coverage_view'[client_billing_country] <> "United Kingdom") 
			        
			        || 
			    
			    ('gold coverage_view'[relm_entity] = "Relm Ins UK Ltd" 
			        && 'gold coverage_view'[broker_mailing_country] = "United Kingdom" 
			        && 'gold coverage_view'[client_billing_country] = "United Kingdom"),
			
			        1,0
			
			)
			```
		formatString: 0
		displayFolder: Old Measures
		lineageTag: 7d0ff24f-90af-4b3c-8946-b74ce8ee7248
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'US RIAI Filter' = ```
			
			
			IF(
			    ('gold coverage_view'[broker_mailing_country] = "United States" 
			        && 'gold coverage_view'[client_billing_country] = "United States" 
			        && 'gold coverage_view'[relm_entity] = "Relm Insurance Agency Inc." 
			        && 'gold coverage_view'[assigned_us_home_state] = "CA"),
			
			        1,0
			
			)
			```
		formatString: 0
		displayFolder: Old Measures
		lineageTag: 76aa9d60-e9df-4f73-9351-001bbaaea304
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'US RUIA Filter' = ```
			
			
			IF(
			    ('gold coverage_view'[broker_mailing_country] = "United States" 
			        && 'gold coverage_view'[client_billing_country] = "United States" 
			        && 'gold coverage_view'[relm_entity] = "Relm US Insurance Agency" 
			        && 'gold coverage_view'[assigned_us_home_state] = "NY"),
			
			        1,0
			
			)
			```
		formatString: 0
		displayFolder: Old Measures
		lineageTag: c0872e0a-f628-4067-93e0-c78a479c036f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'US RUISI Filter' = ```
			
			
			IF(
			    ('gold coverage_view'[broker_mailing_country] = "United States" 
			        && 'gold coverage_view'[client_billing_country] = "United States" 
			        && 'gold coverage_view'[relm_entity] = "Relm US Insurance Solutions Inc." 
			        && NOT('gold coverage_view'[assigned_us_home_state] IN {"CA", "NY"}) 
			        && NOT(ISBLANK('gold coverage_view'[assigned_us_home_state]))),
			
			        1,0
			        
			)
			```
		formatString: 0
		displayFolder: Old Measures
		lineageTag: aacf83bb-6507-4fba-b4ef-8ef386464892
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'US MGA Filter' = IF( [US MGA RIAI] || [US MGA RUIA] || [US MGA RUISI], 1, 0)
		formatString: 0
		displayFolder: Old Measures
		lineageTag: 55cc333e-8203-4aa8-91e2-d2a15bb6e7ae
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

