	column policy_coverage_count
		dataType: int64
		formatString: 0
		lineageTag: 315cd19d-fc07-45dd-bdf8-88356b7f152d
		summarizeBy: sum
		sourceColumn: policy_coverage_count

		annotation SummarizationSetBy = Automatic

	column renewal_account_flag
		dataType: int64
		formatString: 0
		lineageTag: 6bcaedab-2b44-4c08-91a8-6ea1b1483a9b
		summarizeBy: sum
		sourceColumn: renewal_account_flag

		annotation SummarizationSetBy = Automatic

	column 'Opportunity Segment Flag' =
			
			VAR recordType = 'gold coverage_view'[record_type_name]
			VAR brokerCountry = 'gold coverage_view'[broker_mailing_country]
			VAR clientCountry = 'gold coverage_view'[client_billing_country]
			VAR entity = 'gold coverage_view'[relm_entity]
			VAR state = 'gold coverage_view'[assigned_us_home_state]
			
			RETURN
			IF(
			    recordType = "New" &&
			    (
			        /* BDA */
			        (
			            entity = "Relm Insurance Ltd." &&
			            NOT(brokerCountry IN {"United States","United Kingdom","United Arab Emirates"})
			        )
			
			        ||
			
			        /* UK */
			        (
			            brokerCountry = "United Kingdom" &&
			            (
			                (entity = "Relm Insurance Ltd." && clientCountry <> "United Kingdom") ||
			                (entity = "Relm Ins UK Ltd" && clientCountry = "United Kingdom")
			            )
			        )
			
			        ||
			
			        /* MENA */
			        (
			            entity = "Relm Insurance MENA Ltd." &&
			            clientCountry = "United Arab Emirates"
			        )
			
			        ||
			
			        /* US MGA */
			        (
			            brokerCountry = "United States" &&
			            clientCountry = "United States" &&
			            (
			                (entity = "Relm Insurance Agency Inc." && state = "CA") ||
			                (entity = "Relm US Insurance Agency" && state = "NY") ||
			                (
			                    entity = "Relm US Insurance Solutions Inc." &&
			                    NOT(state IN {"CA","NY"}) &&
			                    NOT(ISBLANK(state))
			                )
			            )
			        )
			    ),
			    1,
			    0
			)
		formatString: 0
		displayFolder: Old Measures
		lineageTag: 90ce00f9-e979-4565-85d1-868dce13118d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Renewal Opportunity Name' =
			
			IF(
			    'gold coverage_view'[record_type_name] = "Renewal" &&
			    'gold coverage_view'[Ops Analyst Name] IN {
			        "Jenny Anden",
			        "Clarisse De La Cruz",
			        "Miguel Estoesta"
			    },
			    'gold coverage_view'[opportunity_name],
			    BLANK()
			)
		lineageTag: c1f43a5a-83bb-4fba-a615-52b850646a48
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

