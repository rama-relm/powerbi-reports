	measure SelectedMeasureValue = ```
			
			SWITCH(
			    SELECTEDVALUE(StructureTableWeekly[MetricName]),
			    "BDA Total Opportunities Submitted", COALESCE([BDA_Opportunities],0), 
			    "MENA Total Opportunities Submitted", COALESCE([MENA_Opportunities],0), 
			    "UK Total Opportunities Submitted", COALESCE([UK_Opportunities],0),
			    "Renewal Total Opportunities Submitted", COALESCE([Renewal_Opportunities],0),
			    "US MGA Total Opportunities Submitted", COALESCE([US MGA_Opportunities],0),
			     "Canada Total Opportunities Submitted", COALESCE([CANADA_Opportunities],0),
			    0
			)
			```
