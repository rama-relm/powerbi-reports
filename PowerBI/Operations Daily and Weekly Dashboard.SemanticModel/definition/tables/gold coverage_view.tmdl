	column prior_bound_sub_coverage_date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 7e8ab7de-ea64-45ee-8de3-e159d8005256
		summarizeBy: none
		sourceColumn: prior_bound_sub_coverage_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column country_classification =
			
			SWITCH(
			    TRUE(),
			    'gold coverage_view'[broker_mailing_country] = "United Kingdom", "UK",
			    'gold coverage_view'[client_billing_country] = "United Arab Emirates", "MENA",
			    'gold coverage_view'[broker_mailing_country] = "United States"
			        && 'gold coverage_view'[client_billing_country] = "US",
			        "United States",
			    'gold coverage_view'[broker_mailing_country] = "Bermuda"
			        || NOT('gold coverage_view'[broker_mailing_country] IN {
			            "United States",
			            "United Kingdom",
			            "United Arab Emirates"
			        }),
			        "BDA",
			
			    "Others"
			)
		displayFolder: Old Measures
		lineageTag: b04c6df0-1002-4c06-ab85-2bd9abdcdfc1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column entity_classification =
			
			VAR entity = TRIM('gold coverage_view'[relm_entity])
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(entity), "Blank",
			
			    entity = "Relm Ins UK Ltd", "UK",
			    entity = "Relm Insurance Ltd.", "BDA",
			    entity = "Relm Insurance MENA Ltd.", "MENA",
			
			    entity IN {
			        "Relm US Insurance Solutions Inc.",
			        "Relm Insurance Agency Inc.",
			        "Relm US Insurance Agency"
			    }, "US",
			
			    "Other"
			)
		displayFolder: Old Measures
		lineageTag: b04a25a9-986e-4a72-b785-8fd6ab42293c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column classification_match =
			
			IF(
			    'gold coverage_view'[country_classification] = 'gold coverage_view'[entity_classification],
			    "Matched",
			    "Mismatched"
			)
		displayFolder: Old Measures
		lineageTag: d069ba80-6e7d-4e2a-b1f3-7c01adb86d5b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

