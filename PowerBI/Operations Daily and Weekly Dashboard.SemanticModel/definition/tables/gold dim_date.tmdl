	column 'Current Week' =
			
			IF(
			    WEEKNUM('gold dim_date'[date], 21) = WEEKNUM(TODAY(), 21) &&
			    YEAR('gold dim_date'[date]) = YEAR(TODAY()),
			    "Current Week",
			    "Week " & FORMAT(WEEKNUM('gold dim_date'[date], 21), "00")
			)
		lineageTag: d6022359-a3a8-4a87-9b1b-361d7638c0c2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Current Year' = ```
			IF(  
			    YEAR('gold dim_date'[date]) = YEAR(TODAY()),
			    
			    "Current Year", "Not Current"
			    
			)
			```
		lineageTag: 761184f1-b647-4e15-982a-9981afce2ab3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Week Start (Mon)' =
			
			'gold dim_date'[date] - WEEKDAY('gold dim_date'[date], 2) + 1
		formatString: General Date
		lineageTag: 0fb8bf9f-6915-41fe-92d2-03f056029a52
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Week End (Fri)' =
			
			'gold dim_date'[Week Start (Mon)] + 4
		formatString: General Date
		lineageTag: 95a1bcdb-3b8f-4ab5-8b3a-c35e826626ea
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Week Range Label' = ```
			
			VAR StartDate = 'gold dim_date'[Week Start (Mon)]
			VAR EndDate = 'gold dim_date'[Week End (Fri)]
			
			VAR CurrentWeekStart =
			    TODAY() - WEEKDAY(TODAY(), 2) + 1
			
			VAR DateRange =
			    FORMAT(StartDate, "ddd dd/mmm/yy") 
			    & " - " & 
			    FORMAT(EndDate, "ddd dd/mmm/yy")
			
			RETURN
			IF(
			    StartDate = CurrentWeekStart,
			    "Current Week (" & DateRange & ")",
			    DateRange
			)
			```
		lineageTag: 3f266511-e9d0-4c72-84f5-a491eb0be4b6
		summarizeBy: none
		sortByColumn: 'Week Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Is Current Week' =
			
			IF(
			    'gold dim_date'[Week Start (Mon)] =
			        TODAY() - WEEKDAY(TODAY(), 2) + 1,
			    1,
			    0
			)
		formatString: 0
		lineageTag: cd7b82c7-4fdd-404d-aba4-307e650f278a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Week Sort' =
			
			IF(
			    'gold dim_date'[Week Start (Mon)] =
			        TODAY() - WEEKDAY(TODAY(), 2) + 1,
			    0,
			    'gold dim_date'[Week Start (Mon)]
			)
		lineageTag: b5e0a79a-c339-4b4e-a3cc-5fe1d33473f5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

