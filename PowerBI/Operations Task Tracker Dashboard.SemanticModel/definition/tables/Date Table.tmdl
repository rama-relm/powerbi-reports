	measure Total_Missing_Items =
			
			SUMX(
			    'Date Table',
			    'Date Table'[Approval Document]+
			    'Date Table'[Missing Quotes] +
			    'Date Table'[Missing Binder] +
			    'Date Table'[Missing Invoice] +
			    'Date Table'[Missing Rater] +
			    'Date Table'[UW Summary] +
			    'Date Table'[Loss Runs] +
			    'Date Table'[Warranty] +
			    'Date Table'[Communication] +
			    'Date Table'[Submission Docs] +
			    'Date Table'[OFAC Check]
			)
		formatString: 0
		lineageTag: 501f714c-e701-4fc4-875a-f6ca1094d12f

	measure Missing_By_Doc =
			
			SWITCH(
			    SELECTEDVALUE(Document_Type[Document]),
			
			    "Quote", [Missing Quotes],
			    "Binder", [Missing Binder],
			    "Invoice", [Missing Invoice],
			    "Approval", [Approval Document],
			    "Raters", [Missing Rater],
			    "UW Summary", [UW Summary],
			    "Loss Runs", [Loss Runs],
			    "Warranty", [Warranty],
			    "Submission", [Submission docs],
			    "Communication", [Communication],
			    "OFAC", [OFAC check]
			)
		formatString: 0
		lineageTag: a7d89190-84b1-4ece-87ee-ae8f01231635

	column Date
		isKey
		formatString: Short Date
		lineageTag: 8334b33a-8e52-44e2-89b2-9cc9a947c84f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Year
		formatString: 0
		lineageTag: c5bbf97c-b2cc-4e53-87b6-a935a45669b2
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

