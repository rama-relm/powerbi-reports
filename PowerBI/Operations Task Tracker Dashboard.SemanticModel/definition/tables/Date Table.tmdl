	column 'Month Year' = FORMAT('Date Table'[Date], "MMM YYYY")
		lineageTag: c9759dfa-7669-4d15-b19a-37719de3353c
		summarizeBy: none
		sortByColumn: YearMonthSort

		annotation SummarizationSetBy = Automatic

	column YearMonthSort = YEAR('Date Table'[Date]) * 100 + MONTH('Date Table'[Date])
		formatString: 0
		lineageTag: 8b92b2b3-401f-418d-83c4-c33f2b477ea6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition 'Date Table' = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        DATE(2026, 1, 1),
				        DATE(YEAR(TODAY()) + 2, 12, 31)
				    ),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMM"),
				    "YearMonth", FORMAT([Date], "MMM YYYY")
				)

	annotation PBI_Id = 14fff73ca5d04f21bf33094a1762093e

