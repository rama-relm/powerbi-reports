table 'Date Table'
	lineageTag: 9e6645e9-328b-4b88-befc-073406df03cc
	dataCategory: Time

	measure 'Missing Quotes' =
			
			SUMX(
			    VALUES(audit_master_consolidation[Policy #]),
			    VAR IsSubjective =
			        CONTAINSSTRING(
			            LOWER(CALCULATE(MAX(audit_master_consolidation[Initial Ops Comments]))),
			            "subjectivity"
			        )
			        ||
			        CONTAINSSTRING(
			            LOWER(CALCULATE(MAX(audit_master_consolidation[Second review Ops comments]))),
			            "subjectivity"
			        )
			
			    VAR IsMissing =
			        CALCULATE(MAX(audit_master_consolidation[Quote])) = "No"
			
			    RETURN
			        IF(IsSubjective, BLANK(), IF(IsMissing, 1, 0))
			)
		formatString: 0
		lineageTag: 0e151c7e-4716-4d46-ad27-1ae998b7d5e8

