	column Task_Sort =
			
			SWITCH(
			    TRUE(),
			    'ops_tracking_data'[Task Name] = "Submission", 1,
			    'ops_tracking_data'[Task Name] = "Rework on Submission", 2,
			    'ops_tracking_data'[Task Name] = "Renewals", 3
			)
		formatString: 0
		lineageTag: 6bb36f6e-2bb5-4263-a8fa-1c44be494bb3
