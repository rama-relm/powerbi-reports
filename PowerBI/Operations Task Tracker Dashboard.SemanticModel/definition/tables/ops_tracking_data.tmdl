table ops_tracking_data
	lineageTag: cb027e33-9d2e-466c-b85d-1ddf73780e41

	measure 'Total Time Measure' = ```
			AVERAGE(ops_tracking_data[Total Time])
			 
			```
		lineageTag: 7c0096cd-dcec-42ad-a5f6-e593bb2a1f0e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rounded Value' =
			
			VAR Step = 20
			RETURN ROUND([Total Time Measure] / Step, 0) * Step
		lineageTag: 4a82ddbe-5fe1-4b3a-9091-1eedb2730fee

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Time Current Month' =
			COALESCE(
			CALCULATE(
			    AVERAGE(ops_tracking_data[Total Time]),
			    FILTER(
			        'ops_tracking_data',
			        CONTAINSSTRING(
			            'ops_tracking_data'[User],
			            FORMAT(TODAY(), "MMMYYYY")
			        )
			    )
			),
			0
			)
		lineageTag: 6c6c4474-5202-4365-b423-81ee0268109e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Time' = AVERAGE(ops_tracking_data[Total Time])
		lineageTag: 38abaadf-8369-41bd-a81e-782062c2a516

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Number of Tasks' = ```
			calculate(
			    COUNTROWS(ops_tracking_data)
			)
			
			
			```
		formatString: 0
		lineageTag: 4f91ff05-3bdb-4bea-86b4-2c28c9a05de8

	measure 'Average Per Task' = ```
			
			
			    DIVIDE(
			        CALCULATE(
			            SUM(ops_tracking_data[Total Time]) ),
			        [Number of Tasks]
			    )
			    
			```
		lineageTag: ab0dbe41-b188-4bf8-8788-d96819cd77dc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure No_of_Tasks =
			COALESCE(
			CALCULATE(
			    COUNTROWS('ops_tracking_data'),
			    'ops_tracking_data'[Task Name] IN {
			        "Policy","Quote","Binder","Pending/Returned to UW",
			        "Invoice","Endorsement","Revised Quote",
			        "Revised Policy","Revised Binder"
			    }
			),0)
		formatString: 0
		lineageTag: e95bb3f4-28dd-4bbf-ab3b-16869234b097

	measure Clean_Count =
			
			CALCULATE(
			    [Number of Tasks],
			    FILTER(
			        ops_tracking_data,
			        TRIM(ops_tracking_data[QC Result]) = "Clean"
			    )
			)
		formatString: 0
		lineageTag: 5e061488-0ed6-498e-b406-f80e3b0534bd

	measure Error_Count =
			
			CALCULATE(
			   [Number of Tasks],
			   ops_tracking_data[QC Result] = "With Error"
			   )
		formatString: 0
		lineageTag: 14f5ebb7-13b5-49a7-9e1f-595782c2f2f0

	measure 'QC Rate' =
			
			IF(
			    ISINSCOPE(ops_tracking_data[QC Result]),
			    BLANK(),
			    VAR CleanCount = COALESCE([Clean_Count], 0)
			    VAR ErrorCount = COALESCE([Error_Count], 0)
			    VAR Denominator = CleanCount + ErrorCount
			    RETURN
			        IF(
			            CleanCount = 0 && Denominator = 0,
			            BLANK(),
			            DIVIDE(
			                CleanCount,
			                Denominator,
			                0
			            )
			        )
			)
		lineageTag: 743d4601-4b0f-4c9e-9ef5-14ec8fcd7847

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Error Category Count' =
			
			IF(
			    ISBLANK(SELECTEDVALUE('ops_tracking_data'[Error Category])),
			    0,
			    CALCULATE(
			        DISTINCTCOUNT('ops_tracking_data'[Error Category]),
			        'ops_tracking_data'[Error Category] <> BLANK()
			    )
			)
		formatString: 0
		lineageTag: 51088082-af1a-4ef6-a03b-dd34df2609ff

	measure Total_Clean_and_Error =
			
			[Error_Count] + [Clean_Count]
		formatString: 0
		lineageTag: b32ccf45-840f-4bdd-b171-63b16f268b47

	measure 'Dynamic Error Count' =
			
			IF(
			    ISINSCOPE('ops_tracking_data'[Account Name]),
			    [Error Category Count],
			    SUMX(
			        VALUES('ops_tracking_data'[Account Name]),
			        CALCULATE([Error Category Count])
			    )
			)
		formatString: 0
		lineageTag: aa2f493a-95c0-46a3-acc7-51dce49bd929

	measure Submission_based_tasks_count =
			COALESCE(
			CALCULATE(
			    COUNTROWS('ops_tracking_data'),
			    'ops_tracking_data'[Task Name] IN {
			        "Submission","Renewals","Rework on Submission"
			    }
			),0)
		formatString: 0
		lineageTag: d965a8ed-1a41-485a-bd43-fe2d0afcf17e

	measure Average_Time_Submission_Based_Tasks =
			
			CALCULATE(
			    AVERAGE('ops_tracking_data'[Total Time]),
			    'ops_tracking_data'[Task Name] IN {
			        "Submission",
			        "Rework on Submission",
			        "Renewals"
			    }
			)
		lineageTag: aa1d020d-d016-451b-b92f-e5f10303f361

		annotation PBI_FormatHint = {"isGeneralNumber":true}

