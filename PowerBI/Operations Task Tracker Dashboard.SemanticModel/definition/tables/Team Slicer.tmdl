table 'Team Slicer'
	lineageTag: e69bb2f3-d47f-4ce5-9b1e-4853efdb090e

	measure 'Show Row' =
			
			VAR SelectedTeam = SELECTEDVALUE('Team Slicer'[Team])
			RETURN
			IF(
			    ISBLANK(SelectedTeam),
			    1,  // Show all rows if no selection
			    IF(
			        MAX(ops_tracking_data[Team]) = SelectedTeam,
			        1,
			        0
			    )
			)
		formatString: 0
		lineageTag: ac62f339-359d-4173-907f-b4354179289c

	column Team
		lineageTag: 2ab1f984-6258-4da2-94aa-ba710a284ef2
		summarizeBy: none
		isNameInferred
		sourceColumn: ops_tracking_data[Team]

		annotation SummarizationSetBy = Automatic

	partition 'Team Slicer' = calculated
		mode: import
		source = DISTINCT('ops_tracking_data'[Team])

	annotation PBI_Id = 5c8427ed59e7445cb56f9df0144b38a5

